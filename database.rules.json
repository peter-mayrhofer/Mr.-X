{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$g": {
        "info": {
          ".read": "auth != null"
        },
        "config": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "field": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "state": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "teams": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "reports": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "handovers": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "locks": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "stats": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "archive": {
          ".read": "auth != null && (root.child('games').child($g).child('members').child(auth.uid).exists() || auth.token.superAdmin === true)"
        },
        "members": {
          ".read": "auth != null && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin')",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "pos": {
          ".read": "auth != null && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'schiri' || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'screen')",
          "$t": {
            ".validate": "newData.hasChildren(['lat', 'lng', 'acc', 't'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "acc": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 900000"
            },
            "heading": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360"
            },
            "battery": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'team' && root.child('games').child($g).child('members').child(auth.uid).child('teamId').val() === $t"
          }
        },
        "staffPos": {
          ".read": "auth != null && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'schiri' || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'screen')",
          "$uid": {
            ".validate": "newData.hasChildren(['lat', 'lng', 'acc', 't'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "acc": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 900000"
            },
            "heading": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360"
            },
            "battery": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && auth.uid === $uid && (root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'schiri' || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin')"
          }
        },
        "trackerPos": {
          ".read": "auth != null && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'schiri' || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'screen')"
        },
        "chat": {
          ".read": "auth != null && (auth.token.superAdmin === true || (root.child('games').child($g).child('members').child(auth.uid).exists() && root.child('games').child($g).child('members').child(auth.uid).child('role').val() !== 'viewer'))",
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('games').child($g).child('members').child(auth.uid).exists() && root.child('games').child($g).child('members').child(auth.uid).child('role').val() !== 'viewer' && root.child('games').child($g).child('members').child(auth.uid).child('role').val() !== 'screen') || (data.exists() && !newData.exists() && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin')))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't', 'kind']) && newData.child('uid').val() === auth.uid && newData.child('kind').val() === 'msg' && newData.child('t').val() === now && newData.child('name').val() === root.child('games').child($g).child('members').child(auth.uid).child('name').val() && (root.child('games').child($g).child('members').child(auth.uid).child('teamId').exists() ? newData.child('teamId').val() === root.child('games').child($g).child('members').child(auth.uid).child('teamId').val() : !newData.child('teamId').exists()) && newData.parent().parent().child('rate').child(auth.uid).val() === now",
            "uid": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString()"
            },
            "teamId": {
              ".validate": "newData.isString()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "kind": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "dm": {
          "$t": {
            ".read": "auth != null && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin' || (root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'team' && root.child('games').child($g).child('members').child(auth.uid).child('teamId').val() === $t))",
            "$id": {
              ".write": "auth != null && ((!data.exists() && newData.exists() && (root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin' || (root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'team' && root.child('games').child($g).child('members').child(auth.uid).child('teamId').val() === $t))) || (data.exists() && !newData.exists() && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin')))",
              ".validate": "newData.hasChildren(['uid', 'name', 'text', 't', 'kind']) && newData.child('uid').val() === auth.uid && newData.child('kind').val() === 'msg' && newData.child('t').val() === now && newData.child('name').val() === root.child('games').child($g).child('members').child(auth.uid).child('name').val() && (root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin' ? !newData.child('teamId').exists() : newData.child('teamId').val() === $t) && newData.parent().parent().parent().child('rate').child(auth.uid).val() === now",
              "uid": {
                ".validate": "newData.isString()"
              },
              "name": {
                ".validate": "newData.isString()"
              },
              "teamId": {
                ".validate": "newData.isString()"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
              },
              "t": {
                ".validate": "newData.isNumber()"
              },
              "kind": {
                ".validate": "newData.isString()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "rate": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($g).child('members').child(auth.uid).exists()",
            ".validate": "newData.val() === now && (!data.exists() || data.val() <= now - 2000)"
          }
        },
        "push": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($g).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['token', 'platform'])",
            "token": {
              ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 4096"
            },
            "platform": {
              ".validate": "newData.val() === 'web' || newData.val() === 'android'"
            },
            "prefs": {
              "$k": {
                ".validate": "newData.isBoolean()"
              }
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "audit": {
          ".read": "auth != null && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin')"
        },
        "devices": {
          ".read": "auth != null && (auth.token.superAdmin === true || root.child('games').child($g).child('members').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "userGames": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "gameIndex": {
      ".read": "auth != null && auth.token.superAdmin === true"
    }
  }
}
