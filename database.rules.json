{
  "rules": {
    "teams": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".write": "auth.uid === $uid && !data.exists() && root.child('secret/teamPw').exists() && newData.parent().parent().child('joins').child($uid).val() === root.child('secret/teamPw').val()",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40"
      }
    },
    "joins": {
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "roles": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".write": "auth.uid === $uid && newData.val() === 'admin' && auth.token.email === 'admin@mrx-team.app'",
        ".validate": "newData.val() === 'admin' || newData.val() === 'schiri'"
      }
    },
    "pos": {
      ".read": "root.child('roles').child(auth.uid).exists()",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".write": "auth.uid === $uid",
        ".validate": "newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('t').isNumber()"
      }
    },
    "game": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).exists()"
    },
    "handovers": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).exists()"
    },
    "locks": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).exists()"
    },
    "reports": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$slot": {
        ".write": "!data.exists() && (root.child('roles').child(auth.uid).exists() || root.child('game/mrx').val() === auth.uid)",
        ".validate": "newData.child('team').val() === root.child('game/mrx').val() && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
      }
    },
    "archive": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'"
    },
    "secret": {
      ".read": "root.child('roles').child(auth.uid).val() === 'admin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'"
    },
    "stats": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".write": "auth.uid === $uid"
      }
    },
    "chat": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$id": {
        ".write": "!data.exists() && newData.child('uid').val() === auth.uid && (newData.child('sys').val() !== true || root.child('roles').child(auth.uid).exists() || root.child('game/mrx').val() === auth.uid)",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 500"
      }
    },
    "dm": {
      ".read": "root.child('roles').child(auth.uid).val() === 'admin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$team": {
        ".read": "auth.uid === $team",
        "$id": {
          ".write": "!data.exists() && newData.child('uid').val() === auth.uid && auth.uid === $team",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 500"
        }
      }
    }
  }
}
